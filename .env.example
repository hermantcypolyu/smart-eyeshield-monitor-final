# Copy to `.env` and fill in real values. Never commit `.env`.

# Serial port for the ESP32-S3. Use `auto` to let the app find it by USB VID/PID.
EYE_SHIELD_SERIAL_PORT=auto

# Path to the application config (defaults to config/app.yaml)
EYE_SHIELD_CONFIG=config/app.yaml

# Optional logging override (defaults to the value in config/app.yaml)
EYE_SHIELD_LOG_DIR=logs

# --- Blynk IoT (laptop-side bridge, src/blynk_client.py) ---
# Monitoring and notification ONLY. No button/switch callbacks exist, by
# design: the local alarm must always work with the network unplugged.
# Device auth token from Blynk.Console -> Device info. Never commit it.
BLYNK_AUTH_TOKEN=
# Region server. Use blynk.cloud unless your device is on a regional host
# (e.g. lon1.blynk.cloud, sgp1.blynk.cloud).
BLYNK_SERVER=blynk.cloud
# Set to 0 to run with cloud monitoring deliberately switched off. The demo
# then logs one line and behaves exactly as before.
BLYNK_ENABLED=1

# Template identifiers, for reference only; the HTTPS API does not need them.
BLYNK_TEMPLATE_ID=
BLYNK_TEMPLATE_NAME=

# Wi-Fi credentials are NOT used by the ESP32-S3 in this architecture: the
# board speaks USB Serial JSON and never joins a network. Kept empty so no
# reader is tempted to add firmware-side Wi-Fi. The laptop owns the internet.
WIFI_SSID=
WIFI_PASSWORD=

# Roboflow dataset download key (Phase 1). Never commit a real key.
ROBOFLOW_API_KEY=
