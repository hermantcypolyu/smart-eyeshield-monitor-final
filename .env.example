# Copy to `.env` and fill in real values. Never commit `.env`.

# Serial port for the ESP32-S3. Use `auto` to let the app find it by USB VID/PID.
EYE_SHIELD_SERIAL_PORT=auto

# Path to the application config (defaults to config/app.yaml)
EYE_SHIELD_CONFIG=config/app.yaml

# Optional logging override (defaults to the value in config/app.yaml)
EYE_SHIELD_LOG_DIR=logs

# Blynk credentials are used by the ESP32 firmware, not the laptop application.
# They live in firmware/esp32_eye_shield_monitor/config.h (git-ignored).
# Listed here only so that the move to a laptop-side Blynk bridge can reuse them.
BLYNK_AUTH_TOKEN=
BLYNK_TEMPLATE_ID=
BLYNK_TEMPLATE_NAME=

# Wi-Fi credentials are flashed onto the ESP32-S3 only. Leave empty unless
# a laptop-side tool needs them.
WIFI_SSID=
WIFI_PASSWORD=

# Roboflow dataset download key (Phase 1). Never commit a real key.
ROBOFLOW_API_KEY=
