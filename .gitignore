# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Environments
.venv/
venv/
env/
ENV/
.python-version

# Secrets and local configuration
.env
.env.*
!.env.example
config/app.yaml
firmware/esp32_eye_shield_monitor/config.h
*.pem
*.key

# Model weights and training artifacts.
# Plan section 4 forbids committing large model artifacts, so no weight file is
# ever tracked -- including models/best.pt. The demo laptop keeps it locally;
# see models/README.md. Never add a "!models/best.pt" negation here.
models/*.pt
models/*.onnx
models/*.engine
models/*.mlpackage
models/*.tflite
runs/
training/runs/
*.cache

# Dataset payloads.
# Order matters: gitignore uses last-match-wins, so every negation below must
# come AFTER the ignore rule it carves an exception out of.
data/**/*.txt
data/**/*.json
data/**/*.csv
data/**/*.zip
data/**/*.7z
data/**/*.tar*
data/**/*.db
data/**/*.sqlite3
# Split manifests and class statistics are small, auditable text records that
# must be committed so the test split can be shown as locked and reproducible.
!data/splits/*.json
!data/splits/*.csv
# Phase 1 audit records produced by tools/inspect_dataset.py are evidence, not
# payload: they contain no image pixels and must be reviewable in the repository.
!data/reviewed/audit/*.json
!data/reviewed/audit/*.csv
# Contact sheets are rendered images and stay local/ignored. Listed only so the
# intent is explicit: do NOT add a negation for these. The same rule applies to
# every later review directory.
data/reviewed/audit/artifacts/
data/reviewed/construction_ppe_screen/artifacts/
# Phase 2B suitability-screen summaries. These are statistics and review queues
# with no image pixels, so they must be committable even though the surrounding
# directory holds ignored contact sheets.
!data/reviewed/construction_ppe_screen/*.json
!data/reviewed/construction_ppe_screen/*.csv
# Phase 2B processed baseline. Only the small text manifests and the licence
# attribution are committable evidence; the images and labels stay local. Note
# that data.yaml is deliberately NOT negated -- it records a machine-specific
# absolute 'path:', so it is regenerated by tools/prepare_eye_region_baseline.py
# rather than committed.
data/processed/eye_shield_baseline/artifacts/
!data/processed/eye_shield_baseline/source_manifest.csv
!data/processed/eye_shield_baseline/class_counts.csv
!data/processed/eye_shield_baseline/split_summary.json
!data/processed/eye_shield_baseline/test_manifest.csv
!data/processed/eye_shield_baseline/rejected_candidates.csv
!data/processed/eye_shield_baseline/attribution.md

# Media payloads: ignored globally so raw imagery cannot be committed from any
# directory. These match files, not directories, so the negations below work.
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.tif
*.tiff
*.gif
*.heic
*.mp4
*.mov
*.avi
*.mkv
# Documentation figures are generated and reviewed for licence before commit.
!docs/images/**
!docs/images/**/*.png
!docs/images/**/*.jpg

# Runtime output
logs/
*.log
*.jsonl
experiments/*.json
# The locked-test evaluation report is licence-safe evidence (numbers only, no
# images or weights), so it is allowed to be committed when a real run produces it.
!experiments/model_eval_test.json
experiments/raw/

# OS / editor noise
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Test and coverage output
.pytest_cache/
.coverage
htmlcov/
.coverage.*

# Arduino build output
firmware/**/build/
